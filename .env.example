# ==============================
# UmeTV Frontend — Vite
# ==============================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Render Socket.IO backend URL
VITE_SOCKET_URL=

# ==============================
# UmeTV Backend — Render
# ==============================

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# JSON string containing TURN server configuration
TURN_SERVERS=

PORT=3000

# Production MUST remain false/unset.
# Mock authentication must never be enabled in production.
ALLOW_MOCK_AUTH=false

NODE_ENV=production

# Optional development setting
DISABLE_HMR=false
