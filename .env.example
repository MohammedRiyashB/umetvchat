# ==============================
# UmeTV Frontend — Vite
# ==============================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional Firebase App Check site key (reCAPTCHA v3)
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Render Socket.IO backend URL
VITE_SOCKET_URL=

# ==============================
# UmeTV Backend — Render
# ==============================

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# JSON array string containing TURN server configuration.
# Prefer UDP first, TCP fallback, and TLS via turns:.
# Example: [{"urls":["turn:turn.example.com:3478?transport=udp","turn:turn.example.com:3478?transport=tcp","turns:turn.example.com:5349"],"username":"...","credential":"..."}]
TURN_SERVERS=

PORT=3000

# Production MUST remain false/unset.
ALLOW_MOCK_AUTH=false
NODE_ENV=production

# Optional development setting
DISABLE_HMR=false

# Require Firebase App Check on Socket.IO after the web provider/site key is verified.
REQUIRE_APP_CHECK=false

# Moderator access: comma-separated Firebase UID values.
# Custom Firebase claims "admin=true" or "moderator=true" are also accepted.
ADMIN_UIDS=

# Production realtime scaling:
# Redis now backs Socket.IO pub/sub, presence, rate limits, matchmaking, and match sessions.
# Game sessions remain process-local until the game-state migration phase.
REDIS_URL=
REDIS_PASSWORD=
TURN_REALM=
TURN_USERNAME=
TURN_PASSWORD=
TURN_EXTERNAL_IP=
# Local coturn TLS files (never commit):
# infra/coturn-certs/fullchain.pem
# infra/coturn-certs/privkey.pem

# Set true only when running multiple realtime instances.
REDIS_REQUIRED_FOR_MULTI_INSTANCE=false
