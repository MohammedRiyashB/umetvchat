# ==============================
# UmeTV Frontend — Vite
# ==============================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional Firebase App Check site key (reCAPTCHA v3)
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Render Socket.IO backend URL
VITE_SOCKET_URL=

# ==============================
# UmeTV Backend — Render
# ==============================

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# JSON string containing TURN server configuration
TURN_SERVERS=

PORT=3000

# Production MUST remain false/unset.
# Mock authentication must never be enabled in production.
ALLOW_MOCK_AUTH=false

NODE_ENV=production

# Optional development setting
DISABLE_HMR=false

# Health endpoint is available at /api/health in production.
# Matchmaking/game state is currently process-local; use one realtime instance
# unless a shared-state Socket.IO adapter is configured.

# Set true only after App Check is configured in Firebase Console and the web client has a valid site key.
REQUIRE_APP_CHECK=false
