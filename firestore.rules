rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownProfile(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validProfile(data) {
      return data.keys().hasOnly(['name', 'age', 'gender', 'interests'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.age is string
        && data.age.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.gender is string
        && data.gender in ['male', 'female', 'prefer_not_to_say']
        && data.interests is list
        && data.interests.size() <= 20;
    }

    match /users/{userId} {
      allow read, delete: if ownProfile(userId);
      allow create, update: if ownProfile(userId)
        && validProfile(request.resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
